# Copy to .env.dev and replace every placeholder. Never commit .env.dev.
WORKBENCH_SQL_HOST=127.0.0.1,14333
WORKBENCH_DATABASE=Workbench
WORKBENCH_SETUP_SQL_USER=sa
WORKBENCH_SETUP_SQL_PASSWORD=replace-with-the-one-time-local-setup-secret
WORKBENCH_WEB_SQL_USER=workbench_web_local
WORKBENCH_WEB_SQL_PASSWORD=replace-with-a-distinct-web-secret
WORKBENCH_OPERATOR_SQL_USER=workbench_operator_local
WORKBENCH_OPERATOR_SQL_PASSWORD=replace-with-a-distinct-operator-secret
WORKBENCH_MIGRATOR_SQL_USER=workbench_migrator_local
WORKBENCH_MIGRATOR_SQL_PASSWORD=replace-with-a-distinct-migrator-secret
WORKBENCH_TENANT_CONTEXT_PROOF_KEY=replace-with-32-random-bytes-encoded-as-base64
WORKBENCH_DEV_TENANT_NAME=Local Workbench
WORKBENCH_DEV_ADMIN_EMAIL=admin@example.test
WORKBENCH_DEV_ADMIN_PASSWORD=replace-with-a-strong-local-admin-password
