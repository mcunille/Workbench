# Non-secret settings. Copy outside the checkout and supply with --env-file.
WORKBENCH_IMAGE=registry.example.com/workbench@sha256:REPLACE_WITH_RELEASE_DIGEST
WORKBENCH_PUBLIC_HOST=workbench.example.com
WORKBENCH_PUBLIC_ORIGIN=https://workbench.example.com
WORKBENCH_INSTALLATION_ID=REPLACE_WITH_STABLE_UUID
WORKBENCH_SECRET_DIRECTORY=/srv/workbench/secrets
WORKBENCH_KNOWN_PROXY=172.30.74.2
WORKBENCH_INGRESS_SUBNET=172.30.74.0/24
WORKBENCH_INGRESS_DYNAMIC_RANGE=172.30.74.128/25
WORKBENCH_DELIVERY_PROVIDER=Disabled
WORKBENCH_PUBLIC_RECOVERY_ENABLED=false
WORKBENCH_PUBLIC_INVITATION_ENABLED=false
# To enable authenticated SMTP after testing:
# WORKBENCH_DELIVERY_PROVIDER=Smtp
# WORKBENCH_SMTP_HOST=smtp.example.com
# WORKBENCH_SMTP_USERNAME=workbench
# WORKBENCH_SMTP_SENDER=workbench@example.com
