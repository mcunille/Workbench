<RunSettings>
  <RunConfiguration><MaxCpuCount>1</MaxCpuCount></RunConfiguration>
  <DataCollectionRunSettings><DataCollectors><DataCollector friendlyName="XPlat Code Coverage"><Configuration>
    <Format>cobertura</Format>
    <Include>[Workbench.Server]*,[Workbench.Database]*</Include>
  </Configuration></DataCollector></DataCollectors></DataCollectionRunSettings>
  <xUnit><ParallelizeAssembly>false</ParallelizeAssembly><ParallelizeTestCollections>false</ParallelizeTestCollections><MaxParallelThreads>1</MaxParallelThreads></xUnit>
</RunSettings>
