        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "tenantName": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
